{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [],
  "framework": "nextjs",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "AhrefsBot"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
