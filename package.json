{
  "name": "albion-kill-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web app — deploy to Vercel only (no background workers)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "vm:icons:cache": "tsx --env-file=.env ../deploy/vm/scripts/cache-item-icons.ts",
    "vm:icons:push": "bash ../deploy/vm/scripts/commit-push-icon-cache.sh",
    "vm:items:catalog": "tsx ../deploy/vm/scripts/build-item-catalog.ts",
    "vm:db:apply-api-sync-health": "tsx --env-file=.env ../deploy/vm/scripts/apply-api-sync-health-schema.ts",
    "vm:db:apply-alliance-battles": "tsx --env-file=.env ../deploy/vm/scripts/apply-alliance-battles-schema.ts",
    "vm:db:apply-kill-fame-idx": "tsx --env-file=.env ../deploy/vm/scripts/apply-kill-fame-idx.ts",
    "vm:db:apply-battle-detail-unavailable": "tsx --env-file=.env ../deploy/vm/scripts/apply-battle-detail-unavailable-schema.ts",
    "vm:db:apply-battle-detail-eviction": "tsx --env-file=.env ../deploy/vm/scripts/apply-battle-detail-eviction-schema.ts",
    "vm:db:reclassify": "tsx --env-file=.env ../deploy/vm/scripts/reclassify-kills.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "next": "^16.3.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
