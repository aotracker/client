{
  "name": "albion-kill-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web app — deploy to Vercel only (no background workers)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "analyze": "next build",
    "test": "vitest run",
    "check:drift": "node scripts/check-lib-drift.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "vm:icons:cache": "tsx --env-file=.env ../deploy/vm/scripts/cache-item-icons.ts",
    "vm:icons:push": "bash ../deploy/vm/scripts/commit-push-icon-cache.sh",
    "vm:items:catalog": "tsx ../deploy/vm/scripts/build-item-catalog.ts",
    "vm:db:reclassify": "tsx --env-file=.env ../deploy/vm/scripts/reclassify-kills.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
