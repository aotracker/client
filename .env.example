# Local development (web app + Postgres; job triggers via ingest API)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
NEXT_PUBLIC_APP_URL=http://localhost:3000

INGEST_API_URL=http://localhost:3001
INGEST_API_SECRET=change-me-in-production

# Comma-separated region slugs to disable (americas, europe, asia). Empty = all enabled.
DISABLED_REGIONS=asia

# Secures ops routes (/api/cron/*, /status). Optional locally.
CRON_SECRET=change-me-in-production

# --- Vercel production (required) ---
# DATABASE_URL=postgresql://albion:PASSWORD@VM_HOST:5432/albion_kills?sslmode=no-verify
# INGEST_API_URL=http://VM_HOST:3001
# INGEST_API_SECRET=shared-secret-with-ingest
# CRON_SECRET=strong-random-secret
# DISABLED_REGIONS=asia
# NEXT_PUBLIC_APP_URL=https://www.aotracker.net

# --- Vercel production (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_ITEM_ICON_CDN=https://...

# Not needed on Vercel (defaults apply; no Redis/pooler on serverless):
# DATABASE_USE_POOLER — omit (defaults false)
# DATABASE_POOL_MAX — omit (auto 1 when VERCEL=1)
# REDIS_URL — ingest workers only, on OVH VM

# Workers + ingest API run on OVH VM: /home/ubuntu/ingest — see ingest/.env.example
