# Local development (web app + Postgres; job triggers via ingest API)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ingest HTTP API (run `npm run api` in ../ingest/ locally)
INGEST_API_URL=http://localhost:3001
INGEST_API_SECRET=change-me-in-production

# Comma-separated region slugs to disable (americas, europe, asia). Empty = all enabled.
DISABLED_REGIONS=asia

# Secures ops routes (/api/cron/*, /status). Optional locally.
CRON_SECRET=change-me-in-production

# --- Vercel production (set in Vercel dashboard) ---
# DATABASE_URL=postgresql://albion:PASSWORD@VM_IP:5432/albion_kills?sslmode=no-verify
# INGEST_API_URL=http://VM_IP:3001
# INGEST_API_SECRET=shared-secret-with-ingest
# DATABASE_USE_POOLER=false
# DATABASE_POOL_MAX=1
# NEXT_PUBLIC_APP_URL=https://www.aotracker.net

# Background workers + HTTP API run on the OVH VM from ../ingest/ — see ingest/.env.example
