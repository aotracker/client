# Local development (web app + Postgres; job triggers via ingest API)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
NEXT_PUBLIC_APP_URL=http://localhost:3000

INGEST_API_URL=http://localhost:3001
INGEST_API_SECRET=change-me-in-production

# Comma-separated region slugs to disable (americas, europe, asia). Empty = all enabled.
DISABLED_REGIONS=

# Secures machine ops routes (/api/cron/*, Bearer on /api/admin/*). Optional locally.
CRON_SECRET=change-me-in-production

# --- Website login (Better Auth) ---
# Portal redirects must include:
#   http://localhost:3000/api/auth/callback/discord
#   http://localhost:3000/api/auth/callback/google
#   https://www.aotracker.net/api/auth/callback/discord
#   https://www.aotracker.net/api/auth/callback/google
BETTER_AUTH_SECRET=  # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=  # OAuth client secret — not the bot token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public IDs control Sign In / login button visibility (same values as server client ids)
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# BOOTSTRAP_ADMIN_DISCORD_ID=  # optional Discord snowflake; auto-admin on first matching sign-in
# BOOTSTRAP_ADMIN_GOOGLE_ID=  # optional Google subject (sub); auto-admin on first matching sign-in

# --- Vercel production (required) ---
# DATABASE_URL=postgresql://albion:PASSWORD@VM_PUBLIC_IP:5432/albion_kills?sslmode=no-verify
# INGEST_API_URL=https://queue.aotracker.net
# INGEST_API_SECRET=shared-secret-with-ingest
# CRON_SECRET=strong-random-secret
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://www.aotracker.net
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISABLED_REGIONS=
# NEXT_PUBLIC_APP_URL=https://www.aotracker.net

# --- Vercel production (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_ITEM_ICON_CDN=https://cdn.aotracker.net/item-icons
# NEXT_PUBLIC_DISCORD_CLIENT_ID=  # public Application ID for /discord invite + Discord login button
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=  # public Google OAuth client id (login button visibility)
# BOOTSTRAP_ADMIN_DISCORD_ID=

# Not needed on Vercel (defaults apply; no Redis/pooler on serverless):
# DATABASE_USE_POOLER — omit (defaults false)
# DATABASE_POOL_MAX — omit (auto 1 when VERCEL=1)
# REDIS_URL — ingest workers only, on OVH VM

# Workers + ingest API run on OVH VM: /home/ubuntu/ingest — see ingest/.env.example
